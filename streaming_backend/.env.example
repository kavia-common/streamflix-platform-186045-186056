# =========================
# StreamFlix Backend (.env)
# =========================

# ---- Database (choose one) ----
# Option A: Full SQLAlchemy URL (preferred)
# DATABASE_URL=sqlite:////absolute/path/to/streamflix.sqlite3
#
# Option B: Deterministic SQLite file path (backend will build sqlite URL from this)
#
# When running the multi-container app in this monorepo, point SQLITE_PATH at the deterministic
# DB created by `streaming_database`:
#   ../streamflix-platform-186045-186054/streaming_database/data/streamflix.sqlite3
#
# (Relative paths resolve from the backend working directory.)
SQLITE_PATH=../streamflix-platform-186045-186054/streaming_database/data/streamflix.sqlite3

# ---- Auth/JWT ----
# REQUIRED: secret used to sign JWTs
JWT_SECRET=change-me-in-production

# Token lifetime in minutes
JWT_EXPIRES_MINUTES=10080

# Cookie name for JWT
JWT_COOKIE_NAME=streamflix_access

# Cookie security flags
#
# Local dev (http://localhost:*):
#   COOKIE_SECURE=false
#   COOKIE_SAMESITE=lax
#
# Preview/prod (https):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none   (only if your frontend is truly cross-site)
COOKIE_SECURE=false
# Optional cookie domain (e.g. .example.com). Leave empty for host-only cookies (recommended for localhost).
COOKIE_DOMAIN=
# SameSite policy: lax|strict|none
COOKIE_SAMESITE=lax

# ---- CORS ----
# Comma-separated list of allowed origins (frontend URLs). Must match exact scheme+host+port.
# Vite dev default is http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Media ----
# Directory on disk containing video files referenced by Video.file_path (absolute or relative to backend root).
VIDEO_LIBRARY_PATH=media
# Maximum chunk size used for streaming (bytes)
STREAM_CHUNK_SIZE=1048576
