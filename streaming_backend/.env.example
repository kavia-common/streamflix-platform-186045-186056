# =========================
# StreamFlix Backend (.env)
# =========================

# ---- Database (choose one) ----
# Option A: Full SQLAlchemy URL (preferred)
# DATABASE_URL=sqlite:////absolute/path/to/streamflix.db
#
# Option B: Deterministic SQLite file path (backend will build sqlite URL from this)
# SQLITE_PATH=/absolute/path/to/streamflix.db

# ---- Auth/JWT ----
# REQUIRED: secret used to sign JWTs
JWT_SECRET=change-me-in-production

# Token lifetime in minutes
JWT_EXPIRES_MINUTES=10080

# Cookie name for JWT
JWT_COOKIE_NAME=streamflix_access

# Cookie security flags
# For HTTPS deployments, set true.
COOKIE_SECURE=true
# Optional cookie domain (e.g. .example.com). Leave empty for host-only cookies.
COOKIE_DOMAIN=
# SameSite policy: lax|strict|none
COOKIE_SAMESITE=lax

# ---- CORS ----
# Comma-separated list of allowed origins (frontend URLs). Must match exact scheme+host+port.
CORS_ORIGINS=http://localhost:3000

# ---- Media ----
# Directory on disk containing video files referenced by Video.file_path (absolute or relative to backend root).
VIDEO_LIBRARY_PATH=media
# Maximum chunk size used for streaming (bytes)
STREAM_CHUNK_SIZE=1048576
