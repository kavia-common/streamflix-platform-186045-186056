# Backend environment example for local development

# Security
SECRET_KEY=change-this-in-production
TOKEN_EXPIRE_MIN=120

# Cookies
# COOKIE_SECURE=false           # set true when serving over HTTPS with cross-site cookies
# COOKIE_SAMESITE=lax           # use 'none' when cross-site over HTTPS
# COOKIE_DOMAIN=localhost       # optional, usually omit for localhost

# CORS / Origins
# Preferred explicit frontend URL (overrides default http://localhost:3000)
# REACT_APP_FRONTEND_URL=http://localhost:3000
# or alternatively:
# FRONTEND_ORIGIN=http://localhost:3000

# Media/DB
# MEDIA_DIR=/absolute/path/to/streaming_backend/media
# DB_PATH=/absolute/path/to/streaming_backend/data/app.db
